{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/images/projects/(.*)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/pdf"
                }
            ]
        }
    ]
}